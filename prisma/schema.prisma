generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
}

model Booking {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  eventType   String
  eventDate   String
  message     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

// prisma/schema.prisma

model Inquiry {
  id            Int       @id @default(autoincrement())
  fullName      String
  email         String
  phone         String?
  eventType     String
  preferredDate String?
  message       String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  venue         Venue?
}

model Venue {
  id         Int      @id @default(autoincrement())
  inquiryId  Int      @unique
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  venueName  String
  address    String?
  city       String?
  notes      String?
  lat        Float?
  lng        Float?
  createdAt  DateTime @default(now())
}