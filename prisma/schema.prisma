generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
model Booking {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String
  eventType   String
  eventDate   String
  message     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}